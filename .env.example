# Runtime database connection (Supabase transaction pooler in hosted environments).
# In development this is the dev project or the local stack, never production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct or session-pooled connection to the same database as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct connection to the dev Supabase project. Schema tooling and
# `pnpm db:migrate:dev` target this, and production migrations are rehearsed
# here before they are allowed through.
DEV_DIRECT_DATABASE_URL=

# Direct connection to the production project. Set only to run
# `pnpm db:migrate:prod`; leave it empty otherwise.
PRODUCTION_DIRECT_DATABASE_URL=

# The database integration tests read and delete rows in. Never production.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project reference of production. Guards refuse any non-production
# command that resolves to it.
PRAXIS_PRODUCTION_PROJECT_REF=

# Safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Protects the retention endpoint invoked by the deployment scheduler.
MAINTENANCE_SECRET=

# Google OAuth client (Web application) with the Google Sheets API enabled.
# Also backs Google sign-in, so <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback must
# be registered on the client alongside GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Seals stored refresh tokens. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Spreadsheet the application tracker mirrors; one tab per recruiting cycle.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab and cycle new applications are filed under.
APPLICATIONS_CYCLE=S27
