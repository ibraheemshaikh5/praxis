# Runtime database connection (Supabase transaction pooler in hosted environments).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct or session-pooled connection used only by schema tooling and smoke tests.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Protects the retention endpoint invoked by the deployment scheduler.
MAINTENANCE_SECRET=
